{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "campaign.schema.json",
  "title": "Campaign",
  "description": "ЧЕРНОВИК контракта. Сверить с доменной моделью заказчика и поправить имена полей.",
  "type": "object",
  "required": ["name", "advertiser_id", "goal", "offer", "segment_ids", "placement_ids", "budget_rub", "start_date", "end_date"],
  "properties": {
    "id": {"type": "string"},
    "status": {"enum": ["draft", "needs_info", "ready", "generated", "moderation", "approved", "rejected", "active", "paused", "finished"]},
    "name": {"type": "string"},
    "advertiser_id": {"type": "string", "description": "ссылка на справочник advertisers"},
    "goal": {"enum": ["visits", "clicks", "calls", "awareness", "installs", "product_sales"]},
    "object": {"type": "string", "description": "что рекламируем: товар, услуга, акция"},
    "offer": {"type": "string"},
    "target_client": {"type": "string", "description": "портрет конечного клиента"},
    "segment_ids": {"type": "array", "items": {"type": "string"}},
    "placement_ids": {"type": "array", "items": {"type": "string"}},
    "budget_rub": {"type": "number", "minimum": 0},
    "start_date": {"type": "string", "format": "date"},
    "end_date": {"type": "string", "format": "date"},
    "show_hours": {"type": "string", "example": "07:00-12:00"},
    "frequency_cap_per_day": {"type": "integer"},
    "start_condition": {"type": "string"},
    "stop_condition": {"type": "string"},
    "metrics": {"type": "array", "items": {"type": "string"}},
    "control_group_pct": {"type": "number"},
    "landing_url": {"type": "string"},
    "creatives": {"type": "array", "items": {"$ref": "#/$defs/creative"}},
    "field_sources": {"type": "object", "additionalProperties": {"enum": ["request", "ai", "asked", "system"]}},
    "source_request": {"type": "string"},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"}
  },
  "$defs": {
    "creative": {
      "type": "object",
      "required": ["placement_id", "type", "title"],
      "properties": {
        "id": {"type": "string"},
        "placement_id": {"type": "string"},
        "type": {"enum": ["smart_banner", "feed_banner", "promo_banner", "stories", "push"]},
        "title": {"type": "string"},
        "text": {"type": "string"},
        "button": {"type": "string"},
        "image_url": {"type": "string"},
        "slides": {"type": "array", "items": {"type": "object"}},
        "variant": {"type": "string"}
      }
    }
  }
}
