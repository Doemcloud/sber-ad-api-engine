# Провайдер LLM: openai (любой OpenAI-совместимый API) или gigachat (нативный API GigaChat)
LLM_PROVIDER=openai

# --- openai-совместимый: OpenAI, OpenRouter, vLLM, Ollama, прокси к GigaChat ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- gigachat ---
# GIGACHAT_AUTH_KEY=        # ключ авторизации (Basic) из кабинета разработчика
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# LLM_MODEL=GigaChat-2-Max
# GIGACHAT_CA_BUNDLE=/certs/russian_trusted_root_ca.cer   # или GIGACHAT_VERIFY_SSL=0 на демо
