# Провайдер LLM: openai (любой OpenAI-совместимый API) или gigachat (нативный API GigaChat)
LLM_PROVIDER=openai

# --- openai-совместимый: OpenAI, OpenRouter, vLLM, Ollama, прокси к GigaChat ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- gigachat (основной провайдер заказчика) ---
# LLM_PROVIDER=gigachat
# Либо готовый ключ авторизации (Authorization key из кабинета), либо Client ID + Client Secret:
# GIGACHAT_AUTH_KEY=
# GIGACHAT_CLIENT_ID=
# GIGACHAT_CLIENT_SECRET=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS          # PERS — физлицо, B2B/CORP — юрлицо
# LLM_MODEL=GigaChat-3-Ultra                # или GigaChat-2-Max / GigaChat-2-Pro
# GIGACHAT_BASE_URL=https://api.giga.chat/v1       # по умолчанию пробует его, затем gigachat.devices.sberbank.ru
# Физлицу GigaChat даёт один поток: агент шлёт запросы по очереди, 429 повторяет с паузой
# GIGACHAT_MAX_RETRIES=5
# GIGACHAT_MIN_INTERVAL=0.3
# GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# Сертификат Минцифры «Russian Trusted Root CA» (в контейнере — ./certs смонтирована в /certs):
# GIGACHAT_CA_BUNDLE=/certs/russian_trusted_root_ca.crt
# GIGACHAT_VERIFY_SSL=0                     # только для демо, если сертификата нет

# Сколько вызовов инструментов агент делает за один ответ (GigaChat — по одному за шаг)
# AGENT_MAX_STEPS=30

# --- вход в кабинет (демо-учётки: client/client — менеджер, moder/moder — модератор; data/mock/users.json) ---
# AUTH_SECRET=      # ключ подписи токенов входа — поменяйте для стенда
# SERVICE_KEY=      # общий ключ API ↔ агент

# --- база данных: PostgreSQL 16 ---
# DB_PASSWORD=adcamp
